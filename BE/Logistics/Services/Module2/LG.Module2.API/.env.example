# Copy file này thành .env và điền giá trị thực — KHÔNG commit .env lên git

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL local
DATABASE_URL=Host=localhost;Port=5432;Database=muaho_mod2;Username=postgres;Password=CHANGE_ME

# ── JWT (dùng chung secret với Auth service và Module1) ───────────────────────
Jwt__SecretKey=CHANGE_ME_USE_LONG_RANDOM_STRING_MIN_32_CHARS

# ── CORS ──────────────────────────────────────────────────────────────────────
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

# ── GHTK (Giao Hàng Tiết Kiệm) ────────────────────────────────────────────────
# Lấy Token tại https://khachhang.giaohangtietkiem.vn/web/thong-tin-shop/cau-hinh-api
# Bỏ trống Token/ClientSource → hệ thống tự fallback sang carrier stub (dev).
Ghtk__Token=
Ghtk__ClientSource=
Ghtk__WebhookToken=
Ghtk__Pick__Name=Kho MuaHo Hà Nội
Ghtk__Pick__Tel=
Ghtk__Pick__Address=
Ghtk__Pick__Province=Hà Nội
Ghtk__Pick__District=
Ghtk__Pick__Ward=
