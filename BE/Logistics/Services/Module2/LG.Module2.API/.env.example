# Copy file này thành .env và điền giá trị thực — KHÔNG commit .env lên git

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL local
DATABASE_URL=Host=localhost;Port=5432;Database=muaho_mod2;Username=postgres;Password=CHANGE_ME

# ── JWT (dùng chung secret với Auth service và Module1) ───────────────────────
Jwt__SecretKey=CHANGE_ME_USE_LONG_RANDOM_STRING_MIN_32_CHARS

# ── CORS ──────────────────────────────────────────────────────────────────────
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

# ── Model ML dự báo lead time (Bước 8 LeadTime.md) ────────────────────────────
# Thư mục chứa leadtime.zip + conformal.csv (xuất từ LG.Module2.Trainer).
# Bỏ trống → forecast dùng heuristic. Dev trỏ thẳng vào output của Trainer:
# Ai__ModelDirectory=/duong/dan/BE/Logistics/Services/Module2/LG.Module2.Trainer/models
Ai__ModelDirectory=

# ── Core Finance (ví khách — trừ/hoàn tiền thật) ──────────────────────────────
# LG.Core.API mặc định chạy https://localhost:7215
Core__BaseUrl=https://localhost:7215

# ── GHTK (Giao Hàng Tiết Kiệm) ────────────────────────────────────────────────
# Lấy Token tại https://khachhang.giaohangtietkiem.vn/web/thong-tin-shop/cau-hinh-api
# Bỏ trống Token → hệ thống tự fallback sang carrier stub (dev).
# ClientSource (X-Client-Source) chỉ cần với tài khoản đối tác, shop thường bỏ trống.
Ghtk__Token=
Ghtk__ClientSource=
Ghtk__WebhookToken=
Ghtk__Pick__Name=Kho MuaHo Hà Nội
Ghtk__Pick__Tel=
Ghtk__Pick__Address=
Ghtk__Pick__Province=Hà Nội
Ghtk__Pick__District=
Ghtk__Pick__Ward=
